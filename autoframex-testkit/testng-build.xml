<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    autoframex-testkit build-gating suite — this module's own default (see
    the testng.suite.file property override in autoframex-testkit/pom.xml),
    used automatically by a plain `mvn install`/`mvn test` (no flags).

    Deliberately excludes the "Cucumber PicoContainer DI" block from
    testng.xml: runners.CucumberRunner drives a real Chrome session against
    a real app on localhost:8080, which isn't available in an unattended
    build environment. That block still runs, on purpose, when testng.xml
    itself is invoked explicitly against a real target application (e.g.
    the "TestNG Suite" Jenkins stage, which runs inside K8s where a real
    app exists) — see:
        mvn test -Dtestng.suite.file=testng.xml
-->
<suite name="autoFrameX Build Suite" verbose="1" parallel="none">

    <listeners>
        <listener class-name="com.framework.testng.api.base.TestAnnotationTransformer"/>
    </listeners>

    <parameter name="configClass" value="com.framework.config.data.AutoFrameXConfiguration"/>

    <parameter name="browser"   value="${browser}"/>
    <parameter name="env"       value="${env}"/>
    <parameter name="headless"  value="${headless}"/>

    <test name="Framework Unit Tests">
        <classes>
            <class name="com.framework.testng.ExtentBugTest"/>
        </classes>
    </test>

    <test name="Performance Tests">
        <groups>
            <run><include name="performance"/></run>
        </groups>
        <packages>
            <package name="com.framework.performance"/>
        </packages>
    </test>

    <test name="Security Tests">
        <groups>
            <run><include name="security"/></run>
        </groups>
        <packages>
            <package name="com.framework.security"/>
        </packages>
    </test>

</suite>
