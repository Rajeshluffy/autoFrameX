# TEMPLATE — copy into your own project's resources as <yourProject>Config.properties
# (e.g. leafTapConfig.properties, alfaDOCKConfig.properties). Not loaded by
# anything itself — the "yourproject.*" keys below are examples; your actual
# keys are whatever @Key(...) annotations your ProjectAppConfiguration
# implementation declares (see the Java snippet at the bottom of this file
# and com.framework.config.data.ProjectAppConfiguration's javadoc for the
# full contract this is implementing).
#
# Never commit real credentials here — override username/password/db.password
# via environment variables or your CI's secret store instead.
# ==============================================================================

# ── Environment URLs (ProjectDirector routes to one of these via the
#    "environment" TestNG/CLI parameter: dev/qa/prod — see ProjectDirector.resolveUrl) ──
yourproject.aut.dev.url=https://dev.yourapp.example.com/
yourproject.aut.qa.url=https://qa.yourapp.example.com/
yourproject.aut.prod.url=

# ── Primary login credentials ────────────────────────────────────────────────
yourproject.username=<YOUR_USERNAME>
yourproject.password=<YOUR_PASSWORD>

# ── Database (optional — leave blank if your project doesn't need one;
#    ProjectAppConfiguration defaults these to "" so it's safe to omit) ──────
yourproject.db.url=
yourproject.db.username=
yourproject.db.password=
yourproject.db.query=

