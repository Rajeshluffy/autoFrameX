# Files and directories to exclude from the Docker build context.
# Keeping the context small speeds up docker build and avoids leaking
# sensitive files or large binary artifacts into the image.

# Build output
target/

# Version control
.git/
.github/

# Test artifacts (generated at runtime, not needed at build time)
reports/
logs/
test-output/
*.log

# IDE and OS metadata
.idea/
.vscode/
.settings/
.classpath
.project
*.iml
.DS_Store
Thumbs.db

# Documentation (not needed inside the image)
docs/

# Sensitive config files — must never be baked into an image layer.
#
# The "**/" prefix is required: Docker matches a bare pattern such as
# "alfaDOCKConfig.properties" against the build-context ROOT only (unlike
# .gitignore, which matches at any depth). The Jenkinsfile's "Inject Configs"
# stage drops these files under autoframex-core/src/main/resources/, so the old
# bare names never matched and the credentials were copied into the image.
#
# Consequence: the image no longer contains these files, so a suite that needs
# one (AlfaDOCK / Leaftaps) has to receive it at runtime (e.g. a Kubernetes
# Secret mounted into the pod) -- see the Jenkinsfile's 'Build Docker Image' note.
**/alfaDOCKConfig.properties
**/leafTapConfig.properties
