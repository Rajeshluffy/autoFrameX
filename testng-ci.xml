<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    CI-only TestNG suite for autoFrameX.

    Runs only the browser-free framework unit tests.
    Used by GitHub Actions ci.yml — no Chrome or WebDriver required.

    For full regression including Cucumber/UI tests, use testng.xml
    or trigger the regression.yml workflow_dispatch.
-->
<suite name="autoFrameX CI Suite" verbose="1" parallel="none">

    <listeners>
        <listener class-name="com.framework.testng.api.base.TestAnnotationTransformer"/>
    </listeners>

    <parameter name="configClass" value="com.framework.config.data.AutoFrameXConfiguration"/>
    <parameter name="browser"     value="chrome"/>
    <parameter name="env"         value="qa"/>
    <parameter name="headless"    value="true"/>

    <!-- Framework unit tests — no WebDriver, no browser required -->
    <test name="Framework Unit Tests">
        <classes>
            <class name="com.framework.testng.ExtentBugTest"/>
            <class name="com.framework.testng.RetryTest"/>
        </classes>
    </test>

</suite>
