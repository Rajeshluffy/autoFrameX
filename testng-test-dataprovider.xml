<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- ══════════════════════════════════════════════════════════════════ LeafTaps 
	Test Suite ══════════════════════════════════════════════════════════════════ 
	URL CONFIGURATION — two approaches, pick ONE per suite: APPROACH A — environment 
	routing (recommended) configClass tells ProjectDirector which properties 
	file to read. environment selects which URL from that file: dev → leaftaps.dev.url 
	= http://leaftaps.com/opentaps/control/main qa → leaftaps.qa.url = http://leaftaps.com/opentaps/control/main 
	prod → leaftaps.prod.url = http://leaftaps.com/opentaps/control/main APPROACH 
	B — direct URL override (bypasses configClass / environment) <parameter name="baseUrl" 
	value="http://leaftaps.com/opentaps/control/main"/> Currently active: APPROACH 
	A (environment=dev) ══════════════════════════════════════════════════════════════════ -->
<suite name="LeafTaps Suite" thread-count="2" verbose="1" parallel="classes" >

	<!-- Which properties file to load -->
	<parameter name="configClass"
		value="com.leaftaps.config.data.LeafTapConfiguration" />

	<!-- Which URL to open: dev | qa | prod -->
	<parameter name="environment" value="dev" />

	<parameter name="browser" value="chrome" />
	<parameter name="maxPoolSize" value="2" />

	<test name="LeafTaps Smoke" >
		<classes >
			<class name="com.leaftaps.testcases.TC001_Verify" />
		</classes>
	</test>

</suite>
