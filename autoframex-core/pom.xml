<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>autoFrameX</groupId>
		<artifactId>autoframex-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>autoframex-core</artifactId>

	<properties>
		<!-- This module's own default suite, so `mvn install`/`mvn test` here
		     (no flags) runs its unit tests automatically instead of falling
		     back to the parent's testng.xml default, which doesn't exist in
		     this module and crashes Surefire. -->
		<testng.suite.file>testng.xml</testng.suite.file>
	</properties>

	<!--
	    Config resolution (com.framework.config.data), reporting/observability
	    (com.framework.utils, com.framework.observability), and the shared
	    exception hierarchy (com.framework.exception). No dependency on
	    Selenium, REST-Assured, Cucumber, or any test-technology library — this
	    is the one module every other module depends on, so it stays
	    deliberately minimal. See ArchitectureRulesTest (autoframex-selenium)
	    for the enforced guardrail.

	    NOTE: com.api.design (ApiClient/ResponseAPI) was originally planned for
	    this module (it has zero framework-internal imports) but turned out to
	    directly import io.restassured.specification.RequestSpecification —
	    caught only when this module first failed to compile (2026-07-15).
	    Moved to autoframex-api instead, since putting it here would have given
	    every module depending on core a transitive RestAssured dependency,
	    defeating the point of a lean core.
	-->

	<dependencies>
		<dependency>
			<groupId>org.testng</groupId>
			<artifactId>testng</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
		</dependency>
		<dependency>
			<groupId>com.aventstack</groupId>
			<artifactId>extentreports</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<dependency>
			<groupId>org.aeonbits.owner</groupId>
			<artifactId>owner</artifactId>
		</dependency>
		<dependency>
			<groupId>com.github.javafaker</groupId>
			<artifactId>javafaker</artifactId>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>
		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-classic</artifactId>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>jul-to-slf4j</artifactId>
		</dependency>
		<dependency>
			<groupId>net.logstash.logback</groupId>
			<artifactId>logstash-logback-encoder</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Publishes a test-jar so autoframex-testkit's aggregate suite
			     (testng.xml) can reference ExtentBugTest, which lives here. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>test-jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
