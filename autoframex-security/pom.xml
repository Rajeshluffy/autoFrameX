<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>autoFrameX</groupId>
		<artifactId>autoframex-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>autoframex-security</artifactId>

	<properties>
		<!-- No unit tests exist in this module yet. Skip Surefire here
		     explicitly rather than falling back to the parent's testng.xml
		     default, which doesn't exist in this module and would crash the
		     build. Remove this once real tests are added. -->
		<skipTests>true</skipTests>
	</properties>

	<!--
	    Security testing utilities: com.framework.security. ZapSecurityUtils
	    drives the OWASP ZAP daemon entirely over its own REST API via
	    RestAssured — no ZAP Java client dependency exists here or anywhere in
	    this reactor (corrected 2026-07-15; the original architecture doc wrongly
	    claimed one did). SecurityTestBase extends
	    com.framework.testng.api.base.ProjectSpecificMethods (autoframex-selenium),
	    so this module depends on selenium too, not just core+api.
	-->

	<dependencies>
		<dependency>
			<groupId>autoFrameX</groupId>
			<artifactId>autoframex-core</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>autoFrameX</groupId>
			<artifactId>autoframex-selenium</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>autoFrameX</groupId>
			<artifactId>autoframex-api</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.testng</groupId>
			<artifactId>testng</artifactId>
		</dependency>
	</dependencies>

</project>
