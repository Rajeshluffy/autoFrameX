<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    autoframex-security unit suite. Needs no browser and no ZAP: ZapSecurityUtilsTest
    talks to a throw-away HTTP server that imitates the ZAP JSON API.
-->
<suite name="autoframex-security Unit Tests" verbose="1" parallel="none">
    <test name="ZAP utilities">
        <classes>
            <class name="com.framework.security.ZapSecurityUtilsTest"/>
            <class name="com.framework.security.SecretDetectorTest"/>
        </classes>
    </test>
</suite>
