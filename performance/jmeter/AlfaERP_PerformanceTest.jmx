          <hashTree>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract erpurlbase -&gt; ERP_HOST" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper;
def slurper = new JsonSlurper();
def body = prev.getResponseDataAsString();
def arr = slurper.parseText(body);
def appSettingsRaw = arr[0].url_appsettings;
def inner = slurper.parseText(appSettingsRaw);
def erpBase = inner.erpurlbase;
vars.put(&apos;erpurlbase&apos;, erpBase);
vars.put(&apos;ERP_HOST&apos;, erpBase + &apos;.alfa-erp.com&apos;);</stringProp>
            </JSR223PostProcessor>
