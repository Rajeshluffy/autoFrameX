            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="AUTH_HOST" elementType="Argument">
            <stringProp name="Argument.name">AUTH_HOST</stringProp>
            <stringProp name="Argument.value">ntc.alfadock-pro.com</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="COMPANY_NAME" elementType="Argument">
            <stringProp name="Argument.name">COMPANY_NAME</stringProp>
            <stringProp name="Argument.value">${__P(companyName,tanakatest)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="COMPANY_PASSWORD" elementType="Argument">
            <stringProp name="Argument.name">COMPANY_PASSWORD</stringProp>
            <stringProp name="Argument.value">${__P(companyPassword,ts123)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="COMPANY_CID" elementType="Argument">
            <stringProp name="Argument.name">COMPANY_CID</stringProp>
            <stringProp name="Argument.value">${__P(companyCid,temp)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="USER_NAME" elementType="Argument">
            <stringProp name="Argument.name">USER_NAME</stringProp>
            <stringProp name="Argument.value">${__P(userName,admin)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="USER_PASSWORD" elementType="Argument">
            <stringProp name="Argument.name">USER_PASSWORD</stringProp>
            <stringProp name="Argument.value">${__P(userPassword,admin)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ERP_APP_NAME" elementType="Argument">
            <stringProp name="Argument.name">ERP_APP_NAME</stringProp>
            <stringProp name="Argument.value">sischeduler</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ERP_KEY" elementType="Argument">
            <stringProp name="Argument.name">ERP_KEY</stringProp>
            <stringProp name="Argument.value">${__P(erpKey,sfGa0kl7lO9fXWaE1rENp)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SEARCH_DATE_FROM" elementType="Argument">
            <stringProp name="Argument.name">SEARCH_DATE_FROM</stringProp>
            <stringProp name="Argument.value">${__P(searchDateFrom,2026-06-28)}</stringProp>
