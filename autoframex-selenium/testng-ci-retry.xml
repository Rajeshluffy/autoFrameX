<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    Retry-engine self-test suite for autoFrameX.

    RetryTest's methods are intentionally always-failing — they exercise the
    RetryEngine's retry/backoff and same-line-failure-detection behavior, not
    application regressions. This suite is expected to end red every run, so it
    is kept separate from testng-ci.xml and run as its own continue-on-error
    step in ci.yml — it must never gate a real merge.
-->
<suite name="autoFrameX CI Retry-Engine Suite" verbose="1" parallel="none">

    <listeners>
        <listener class-name="com.framework.testng.api.base.TestAnnotationTransformer"/>
    </listeners>

    <parameter name="configClass" value="com.framework.config.data.AutoFrameXConfiguration"/>
    <parameter name="browser"     value="chrome"/>
    <parameter name="env"         value="qa"/>
    <parameter name="headless"    value="true"/>

    <test name="Retry Engine Self-Test">
        <classes>
            <class name="com.framework.testng.RetryTest"/>
        </classes>
    </test>

</suite>
