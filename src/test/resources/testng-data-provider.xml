<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  DATA PROVIDER MODE
  ==================
  Runs every test class against ALL accounts listed in the Excel file.

  Required parameters:
    execution.mode  → "data_provider"
    excel.data.file → base name of the .xlsx file under ./data/ (no extension)
    configClass     → fully-qualified ProjectAppConfiguration implementation

  Parallelism:
    parallel="methods"   — each test method runs in its own thread
    thread-count         — max concurrent browser sessions (tune to match pool.max.size)

  Expected behaviour (example):
    Excel has 31 accounts, testng.xml has 2 test classes
    → 62 total executions, up to thread-count running at once
-->
<suite name="DataProviderSuite" parallel="methods" thread-count="5">

    <!-- Execution mode params -->
    <parameter name="execution.mode"  value="data_provider"/>
    <parameter name="excel.data.file" value="accounts"/>

    <!-- Framework config selection — change to your project's config class -->
    <parameter name="configClass"
               value="com.framework.config.data.AutoFrameXConfiguration"/>

    <!-- Optional: target a specific environment (dev / qa / prod) -->
    <parameter name="environment" value="qa"/>

    <listeners>
        <listener class-name="com.framework.testng.api.base.TestAnnotationTransformer"/>
    </listeners>

    <test name="MultiAccountTests">
        <classes>
            <!--
              Add your test classes here.
              Each class's @Test methods must declare:
                @Test(dataProvider = "fetchData")
                public void testMethod(AccountData account) { ... }
            -->
            <!-- <class name="com.alfadock.tests.LoginTest"/> -->
            <!-- <class name="com.alfadock.tests.DashboardTest"/> -->
        </classes>
    </test>

</suite>
