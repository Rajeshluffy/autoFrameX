<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>autoFrameX</groupId>
		<artifactId>autoframex-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>autoframex-database</artifactId>

	<properties>
		<!-- This module's own suite (DBManagerTest uses fake connections - no database
		     needed). Without this the parent's testng.xml default is used, which
		     doesn't exist in this module and would crash Surefire. -->
		<testng.suite.file>testng.xml</testng.suite.file>
		<!-- Coverage floor: line coverage was 47% when this was set; the build fails below it. -->
		<jacoco.minimum.line>0.43</jacoco.minimum.line>
	</properties>

	<!--
	    Database connection pooling (design.patterns.database.*) — its own module
	    (missing from the original TD-20 sketch) since not every consuming team
	    needs mysql-connector-j.
	-->

	<dependencies>
		<dependency>
			<groupId>autoFrameX</groupId>
			<artifactId>autoframex-core</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
		</dependency>
		<dependency>
			<groupId>org.testng</groupId>
			<artifactId>testng</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

</project>
