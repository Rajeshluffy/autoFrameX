<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- ══════════════════════════════════════════════════════════════════ AlfaDOCK 
	Test Suite ══════════════════════════════════════════════════════════════════ 
	URL CONFIGURATION — two approaches, pick ONE per suite: APPROACH A — environment 
	routing (recommended) configClass tells ProjectDirector which properties 
	file to read. environment selects which URL from that file: dev → alfaDOCK.dev.url 
	= https://www.alfadock-pack.com/ qa → alfaDOCK.qa.url = https://ntc.alfadock-pro.com/ 
	prod → alfaDOCK.prod.url = https://www.alfadock-pack.com/ APPROACH B — direct 
	URL override (bypasses configClass / environment) <parameter name="baseUrl" 
	value="https://www.alfadock-pack.com/"/> Currently active: APPROACH A (environment=dev) 
	══════════════════════════════════════════════════════════════════ -->
<suite name="AlfaDOCK Suite" parallel="classes" thread-count="2" verbose="1">

	<!-- Which properties file to load -->
	<parameter name="configClass"
		value="com.alfaDOCK.config.data.AlfaDockConfiguration" />

	<!-- Which URL to open: dev | qa | prod -->
	<parameter name="environment" value="qa" />

	<parameter name="browser" value="chrome" />
	<parameter name="maxPoolSize" value="2" />

	<test name="AlfaDOCK Smoke">
		<classes>
		
		    <class name="com.alfaDOCK.testcases.TC0001_OpenAssemblyTree" />
			
			<class name="com.alfaDOCK.testcases.TC0002_Layer" />
		</classes>
	</test>

</suite>
