<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    GPN Smoke Suite
    Reuses AlfaDockConfiguration because GPN is hosted on the same AlfaDOCK
    platform — same login flow, same base URL (qa environment).
    AlfaDockBaseTest.login() handles company + user login via @BeforeMethod.
-->
<suite name="GPN Suite" parallel="classes" thread-count="1" verbose="1">

	<!-- GPN shares the AlfaDOCK platform → same credentials + URL -->
	<parameter name="configClass"
		value="com.alfaDOCK.config.data.AlfaDockConfiguration" />

	<!-- environment=qa → alfaDOCK.qa.url = https://ntc.alfadock-pro.com/ -->
	<parameter name="environment" value="qa" />

	<parameter name="browser"     value="chrome" />
	<parameter name="maxPoolSize" value="1" />

	<test name="GPN Smoke">
		<classes>
			<class name="com.gpn.testcases.TC001_VerifyFilterButton" />
		</classes>
	</test>

</suite>
