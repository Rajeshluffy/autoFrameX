<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>autoFrameX</groupId>
	<artifactId>autoFrameX</artifactId>
	<version>0.0.1-SNAPSHOT</version>

	<properties>
		<java.version>17</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<testng.suite.file>testng.xml</testng.suite.file>
		<browser>chrome</browser>
		<env>qa</env>
		<headless>false</headless>
		<selenium.version>4.33.0</selenium.version>
		<testng.version>7.7.0</testng.version>
		<apache.poi.version>5.2.4</apache.poi.version>
		<extent.report.version>5.1.2</extent.report.version>
		<rest.assured.version>5.5.0</rest.assured.version>
		<gson.version>2.11.0</gson.version>
		<commons.io.version>2.15.1</commons.io.version>
		<cucumber.jvm.version>7.21.1</cucumber.jvm.version>
		<cucumber.jvm.testng.version>7.21.1</cucumber.jvm.testng.version>
		<cucumber.picocontainer.version>7.21.1</cucumber.picocontainer.version>
		<jackson.databind.version>2.18.0</jackson.databind.version>
		<owner.version>1.0.12</owner.version>
		<faker.version>1.0.2</faker.version>
		<mysql.version>9.6.0</mysql.version>
		<snakeyaml.version>2.6</snakeyaml.version>
		<protobuf.version>4.34.1</protobuf.version>
		<slf4j.version>2.0.5</slf4j.version>
		<logback.version>1.4.7</logback.version>
		<logstash.encoder.version>7.4</logstash.encoder.version>
		<sonar.projectKey>autoFrameX</sonar.projectKey>
		<sonar.projectName>autoFrameX</sonar.projectName>
		<sonar.java.source>17</sonar.java.source>
		<sonar.sources>src/main/java</sonar.sources>
		<sonar.tests>src/test/java</sonar.tests>

	</properties>

	<dependencies>

		<!-- Selenium -->
		<dependency>
			<groupId>org.seleniumhq.selenium</groupId>
			<artifactId>selenium-java</artifactId>
			<version>${selenium.version}</version>
		</dependency>

		<!-- TestNG -->
		<dependency>
			<groupId>org.testng</groupId>
			<artifactId>testng</artifactId>
			<version>${testng.version}</version>
		</dependency>

		<!-- Rest Assured -->
		<dependency>
			<groupId>io.rest-assured</groupId>
			<artifactId>rest-assured</artifactId>
			<version>${rest.assured.version}</version>
		</dependency>

		<dependency>
			<groupId>org.jspecify</groupId>
			<artifactId>jspecify</artifactId>
			<version>1.0.0</version>
			<scope>compile</scope>
		</dependency>

		<!-- JSON Schema Validator — required by RestAssuredResponseBase.verifySchema() -->
		<dependency>
			<groupId>io.rest-assured</groupId>
			<artifactId>json-schema-validator</artifactId>
			<version>${rest.assured.version}</version>
		</dependency>

		<!-- Apache POI -->
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi</artifactId>
			<version>${apache.poi.version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>${apache.poi.version}</version>
		</dependency>

		<!-- Extent Reports -->
		<dependency>
			<groupId>com.aventstack</groupId>
			<artifactId>extentreports</artifactId>
			<version>${extent.report.version}</version>
		</dependency>

		<!-- Cucumber -->
		<dependency>
			<groupId>io.cucumber</groupId>
			<artifactId>cucumber-java</artifactId>
			<version>${cucumber.jvm.version}</version>
		</dependency>
		<dependency>
			<groupId>io.cucumber</groupId>
			<artifactId>cucumber-testng</artifactId>
			<version>${cucumber.jvm.testng.version}</version>
		</dependency>
		<!-- Cucumber PicoContainer — enables constructor injection in step definitions.
		     Shared state between step classes flows through plain Java objects
		     (ScenarioContext, etc.) instead of static fields.           -->
		<dependency>
			<groupId>io.cucumber</groupId>
			<artifactId>cucumber-picocontainer</artifactId>
			<version>${cucumber.picocontainer.version}</version>
		</dependency>

		<!-- Commons IO -->
		<dependency>
			<groupId>commons-io</groupId>
			<artifactId>commons-io</artifactId>
			<version>${commons.io.version}</version>
		</dependency>

		<!-- No direct code usage (confirmed via grep) — each pins a transitive
		     dependency's version up from an older copy something else pulls in
		     (verified via `mvn dependency:tree -Dverbose`, TD-20 audit 2026-07-15):
		     gson overrides extentreports' transitive gson:2.10.1; snakeyaml
		     overrides javafaker's transitive snakeyaml:android:1.23; protobuf-java
		     overrides mysql-connector-j's transitive protobuf-java:4.31.1. -->
		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
			<version>${gson.version}</version>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>${jackson.databind.version}</version>
		</dependency>
		<dependency>
			<groupId>org.yaml</groupId>
			<artifactId>snakeyaml</artifactId>
			<version>${snakeyaml.version}</version>
		</dependency>
		<dependency>
			<groupId>com.google.protobuf</groupId>
			<artifactId>protobuf-java</artifactId>
			<version>${protobuf.version}</version>
		</dependency>

		<!-- Owner Config Library -->
		<dependency>
			<groupId>org.aeonbits.owner</groupId>
			<artifactId>owner</artifactId>
			<version>${owner.version}</version>
		</dependency>

		<!-- Faker Config Library -->
		<dependency>
			<groupId>com.github.javafaker</groupId>
			<artifactId>javafaker</artifactId>
			<version>${faker.version}</version>
		</dependency>

		<!--mysql-connector-j (upgraded for CVE fixes) -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<version>${mysql.version}</version>
		</dependency>

		<!-- SLF4J API -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>${slf4j.version}</version>
		</dependency>

		<!-- Logback — SLF4J implementation -->
		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-classic</artifactId>
			<version>${logback.version}</version>
		</dependency>

		<!-- JUL-to-SLF4J bridge — routes java.util.logging through Logback -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>jul-to-slf4j</artifactId>
			<version>${slf4j.version}</version>
		</dependency>

		<!-- Logstash encoder — JSON log format for ELK Stack ingestion -->
		<dependency>
			<groupId>net.logstash.logback</groupId>
			<artifactId>logstash-logback-encoder</artifactId>
			<version>${logstash.encoder.version}</version>
		</dependency>

		<!-- WireMock — test-scoped; WireMockManager lives in src/test/java -->
		<dependency>
			<groupId>org.wiremock</groupId>
			<artifactId>wiremock-standalone</artifactId>
			<version>3.9.1</version>
			<scope>test</scope>
		</dependency>

		<!-- ArchUnit — test-scoped; core artifact only (no archunit-junit5, this
		     project uses TestNG). Backs the architectural guardrail tests in
		     com.framework.testng.ArchitectureRulesTest. -->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit</artifactId>
			<version>1.3.0</version>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<!-- Maven Compiler Plugin for Java Version -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
				<configuration>
					<source>${java.version}</source>
					<target>${java.version}</target>
					<encoding>${project.build.sourceEncoding}</encoding>
				</configuration>
			</plugin>

			<!-- Maven Source Plugin to share sources -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>3.3.0</version>
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Maven Jar Plugin -> plugin removed as default generation is sufficient -->

			<!-- Maven Surefire Plugin for TestNG -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.0.0-M7</version>
				<configuration>
					<suiteXmlFiles>
						<suiteXmlFile>${testng.suite.file}</suiteXmlFile>
					</suiteXmlFiles>
					<systemPropertyVariables>
						<testng.suite.file>${testng.suite.file}</testng.suite.file>
					</systemPropertyVariables>
				</configuration>
			</plugin>

			<!-- JaCoCo — generates coverage data consumed by SonarQube, and enforces a
			     coverage floor via the "check" execution below. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.12</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals><goal>prepare-agent</goal></goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals><goal>report</goal></goals>
					</execution>
					<!--
					    Coverage floor, bound to the "verify" phase — plain `mvn test` does
					    not run it, so CI runs one extra `mvn verify -Dmaven.test.skip=true`
					    step after its real test suites to enforce this against the
					    cumulative jacoco.exec they already produced in the same job.

					    20% is set deliberately below the ~34% line coverage the parallel
					    smoke suite (testng-parallel-smoke.xml) actually measured at the
					    time this was added — real margin, not a rubber stamp, but low
					    enough that it only catches a genuine regression (e.g. most tests
					    silently failing to run) rather than every routine PR. Ratchet this
					    up as real regression coverage grows; do not lower it to "make CI
					    pass" without also explaining why in the commit message.
					-->
					<execution>
						<id>jacoco-check</id>
						<phase>verify</phase>
						<goals><goal>check</goal></goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.20</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- SonarQube static analysis — run with: mvn sonar:sonar -Dsonar.host.url=... -Dsonar.login=... -->
			<plugin>
				<groupId>org.sonarsource.scanner.maven</groupId>
				<artifactId>sonar-maven-plugin</artifactId>
				<version>3.11.0.3922</version>
			</plugin>

			<!-- Checkstyle — style/consistency checks. Report-only for now (failOnViolation
			     is off): the codebase has never been checked against any ruleset before,
			     so a full retroactive fix-up is out of scope for introducing the tool.
			     Run `mvn checkstyle:check` locally to see the report; flip
			     failOnViolation to true once the existing violation backlog is cleared. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>3.5.0</version>
				<configuration>
					<configLocation>google_checks.xml</configLocation>
					<failOnViolation>false</failOnViolation>
					<violationSeverity>warning</violationSeverity>
				</configuration>
				<executions>
					<execution>
						<id>checkstyle-check</id>
						<phase>verify</phase>
						<goals><goal>check</goal></goals>
					</execution>
				</executions>
			</plugin>

			<!-- PMD — same report-only posture as Checkstyle above, same reason. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-pmd-plugin</artifactId>
				<version>3.26.0</version>
				<configuration>
					<failOnViolation>false</failOnViolation>
					<printFailingErrors>true</printFailingErrors>
				</configuration>
				<executions>
					<execution>
						<id>pmd-check</id>
						<phase>verify</phase>
						<goals><goal>check</goal></goals>
					</execution>
				</executions>
			</plugin>

			<!-- SpotBugs — static bug-pattern detection, same report-only posture. -->
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>4.8.6.6</version>
				<configuration>
					<failOnError>false</failOnError>
				</configuration>
				<executions>
					<execution>
						<id>spotbugs-check</id>
						<phase>verify</phase>
						<goals><goal>check</goal></goals>
					</execution>
				</executions>
			</plugin>

			<!-- OWASP Dependency-Check — SCA scan across ~25 direct dependencies, none
			     of which were scanned for known CVEs before this. Deliberately NOT bound
			     to a lifecycle phase (unlike the tools above): it downloads/updates the
			     NVD CVE feed on first run, which is slow and gets rate-limited without an
			     NVD API key — running it on every push would make CI slow and flaky. Run
			     explicitly with `mvn dependency-check:check` (optionally
			     -Dnvd.api.key=... for faster feed updates), or via the scheduled
			     dependency-check.yml workflow (weekly + manual dispatch), matching how
			     security.yml's ZAP scan is already scheduled/manual rather than per-push. -->
			<plugin>
				<groupId>org.owasp</groupId>
				<artifactId>dependency-check-maven</artifactId>
				<version>10.0.4</version>
				<configuration>
					<failBuildOnCVSS>9</failBuildOnCVSS>
					<formats>
						<format>HTML</format>
						<format>JSON</format>
					</formats>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
