<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    Cucumber lifecycle smoke suite: one real (headless) browser scenario with no network and no application.
    Run it with the app URL pointing at a data: page, which is what the title step expects:

        BASE_URL="data:text/html,<title>autoFrameX smoke</title>" mvn test -pl autoframex-cucumber \
          -Dtestng.suite.file=testng-smoke.xml -Dheadless=true -Djacoco.skip=true

    Not part of the module's default suite (testng.xml) because it needs Chrome; ci.yml runs it.
-->
<suite name="autoframex-cucumber Lifecycle Smoke" verbose="1" parallel="none">
    <test name="Cucumber lifecycle smoke">
        <classes>
            <class name="runners.CucumberSmokeRunner"/>
        </classes>
    </test>
</suite>
