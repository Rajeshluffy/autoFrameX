<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>autoFrameX</groupId>
		<artifactId>autoframex-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>autoframex-cucumber</artifactId>

	<properties>
		<!-- runners.CucumberRunner drives live UI+API scenarios against a real target
		     application - not a fast, isolated unit test suitable for gating an ordinary
		     build - so this module's own suite (testng.xml) lists only browser-free unit
		     tests. The runner still runs, deliberately, via the "Cucumber PicoContainer DI"
		     test block in autoframex-testkit/testng.xml when that suite is invoked. -->
		<testng.suite.file>testng.xml</testng.suite.file>
		<!-- Coverage floor: line coverage was 30% when this was set; the build fails below it. -->
		<jacoco.minimum.line>0.27</jacoco.minimum.line>
	</properties>

	<!--
	    Cucumber BDD glue: com.framework.cucumber.api.base (main), plus the
	    onboarding example runner/step-defs (test) that intentionally span
	    selenium (UI steps) and api (API steps) in one PicoContainer-injected
	    scenario. The lifecycle hooks are CucumberHooks (a runner adds this
	    package to its glue); step classes extend CucumberProjectBase, which has
	    no hooks because Cucumber will not load a step class that extends one.
	-->

	<dependencies>
		<dependency>
			<groupId>autoFrameX</groupId>
			<artifactId>autoframex-core</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>autoFrameX</groupId>
			<artifactId>autoframex-selenium</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>autoFrameX</groupId>
			<artifactId>autoframex-api</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>io.cucumber</groupId>
			<artifactId>cucumber-java</artifactId>
		</dependency>
		<dependency>
			<groupId>io.cucumber</groupId>
			<artifactId>cucumber-testng</artifactId>
		</dependency>
		<!-- Cucumber 8 needs a JSON library to write its reports and brings none: without this a runner fails in
		     @BeforeClass with "Cucumber needs a JSON library to write reports". It used to work only because
		     logstash-logback-encoder 9 happens to pull Jackson 3 in. -->
		<dependency>
			<groupId>tools.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<dependency>
			<groupId>io.cucumber</groupId>
			<artifactId>cucumber-picocontainer</artifactId>
		</dependency>
		<dependency>
			<groupId>org.testng</groupId>
			<artifactId>testng</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Publishes a test-jar so autoframex-testkit's aggregate suite
			     (testng.xml) can reference runners.CucumberRunner, which lives here. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>test-jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
